# SAFE ROUTES HOME — runs with NO API KEYS in this configuration
DEMO_MODE=true
# Map (optional, default is standard OSM tiles; read by Vite, never put secrets in VITE_ vars)
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# Routing (public, no key)
OSRM_URL=https://router.project-osrm.org
# Lighting (public, no key)
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Cameras (empty -> DEMO CAMERA data)
CAMERA_1_URL=
CAMERA_2_URL=
# AI explanation — OPTIONAL, backend only
ENABLE_AI=false
OPENAI_API_KEY=
